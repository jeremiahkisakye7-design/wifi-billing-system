# Server security
SECRET_KEY=generate-a-long-random-value
ADMIN_USERNAME=choose-a-private-admin-name
ADMIN_PASSWORD=choose-a-strong-admin-password

# Payment provider selection: manual, mtn, airtel, or both
PAYMENT_PROVIDER=manual

# MTN MoMo Uganda Collection API values issued by MTN
MTN_MERCHANT_CODE=
MTN_COLLECTION_PRIMARY_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=mtnuganda

# Airtel Money Uganda merchant API values issued by Airtel
AIRTEL_MERCHANT_CODE=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX

# Public HTTPS callback URL, for example:
PAYMENT_CALLBACK_BASE_URL=https://your-app.onrender.com
PAYMENT_WEBHOOK_SECRET=provider-callback-signing-secret
