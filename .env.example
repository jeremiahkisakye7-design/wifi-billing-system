# Server security
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_USERNAME=choose-a-private-admin-name
ADMIN_PASSWORD=choose-a-strong-admin-password
# Production must use a Werkzeug hash; ADMIN_PASSWORD is for local development only.
ADMIN_PASSWORD_HASH=
# Required in production. Generate a unique Base32 secret and enroll it in an authenticator app.
ADMIN_TOTP_SECRET=
# Set true only when exactly one trusted reverse proxy sits in front of Flask.
TRUST_PROXY_HEADERS=false
# Optional: Redis/Memcached URL for rate limiting across multiple workers, e.g. redis://host:6379
RATE_LIMIT_STORAGE_URL=memory://

# Payment provider selection: manual, mtn, airtel, or both
PAYMENT_PROVIDER=manual

# MTN MoMo Uganda Collection API values issued by MTN
MTN_MERCHANT_CODE=
MTN_COLLECTION_PRIMARY_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=mtnuganda

# Airtel Money Uganda merchant API values issued by Airtel
AIRTEL_MERCHANT_CODE=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_TARGET_ENVIRONMENT=sandbox

# Public HTTPS callback URL, for example:
PAYMENT_CALLBACK_BASE_URL=https://your-app.onrender.com
PAYMENT_WEBHOOK_SECRET=provider-callback-signing-secret

# Manual/USSD fallback recipient number. Kept server-side only; never sent to frontend source.
MANUAL_PAYMENT_RECIPIENT=0741808601
# Public customer-support contact shown at the bottom of the portal.
SUPPORT_INQUIRY_NUMBER=0704270565
# Optional shared secret a router/captive-portal integration must send as X-Router-Key.
ROUTER_API_KEY=
# Secret shared only with the trusted hotspot adapter that signs captive-portal MAC claims.
ROUTER_MAC_SIGNING_SECRET=
# Default number of devices allowed on newly issued vouchers (1-10).
MAX_DEVICES_PER_VOUCHER=1
# Unused issued vouchers expire if not first activated within this many days.
VOUCHER_ACTIVATION_TTL_DAYS=30
# Separate background worker interval; values below 30 seconds are clamped to 30.
SESSION_REAPER_INTERVAL_SECONDS=30
# Optional: your hotspot/RADIUS adapter's own API that force-disconnects a device on expiry.
ROUTER_DISCONNECT_WEBHOOK_URL=
# Fraud detection thresholds
MAX_FAILED_PAYMENT_ATTEMPTS=5
FAILED_ATTEMPT_WINDOW_MINUTES=30
