# Server security
SECRET_KEY=generate-a-long-random-value
ADMIN_USERNAME=choose-a-private-admin-name
ADMIN_PASSWORD=choose-a-strong-admin-password
# Optional: set a werkzeug password hash instead of a plaintext ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=
# Optional: Redis/Memcached URL for rate limiting across multiple workers, e.g. redis://host:6379
RATE_LIMIT_STORAGE_URL=memory://

# Payment provider selection: manual, mtn, airtel, or both
PAYMENT_PROVIDER=manual

# MTN MoMo Uganda Collection API values issued by MTN
MTN_MERCHANT_CODE=
MTN_COLLECTION_PRIMARY_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=mtnuganda

# Airtel Money Uganda merchant API values issued by Airtel
AIRTEL_MERCHANT_CODE=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
AIRTEL_TARGET_ENVIRONMENT=sandbox

# Public HTTPS callback URL, for example:
PAYMENT_CALLBACK_BASE_URL=https://your-app.onrender.com
PAYMENT_WEBHOOK_SECRET=provider-callback-signing-secret

# Manual/USSD fallback recipient number. Kept server-side only; never sent to frontend source.
MANUAL_PAYMENT_RECIPIENT=0741808601
# Public customer-support contact shown at the bottom of the portal.
SUPPORT_INQUIRY_NUMBER=0704270565
# Optional shared secret a router/captive-portal integration must send as X-Router-Key.
ROUTER_API_KEY=
# Fraud detection thresholds
MAX_FAILED_PAYMENT_ATTEMPTS=5
FAILED_ATTEMPT_WINDOW_MINUTES=30
