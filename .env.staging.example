# Copy to .env.staging and replace every placeholder with staging-only values.
SECRET_KEY=replace-with-a-random-32-character-minimum-secret
ADMIN_USERNAME=staging-owner
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=replace-with-staging-werkzeug-password-hash
ADMIN_TOTP_SECRET=replace-with-unique-base32-totp-secret
TRUST_PROXY_HEADERS=false
WIFI_DATA_DIR=/data
ROUTER_API_KEY=replace-with-staging-router-api-key
ROUTER_MAC_SIGNING_SECRET=replace-with-unique-random-32-character-minimum-secret
MAX_DEVICES_PER_VOUCHER=1
VOUCHER_ACTIVATION_TTL_DAYS=30
SESSION_REAPER_INTERVAL_SECONDS=30
RATE_LIMIT_STORAGE_URL=memory://
PAYMENT_PROVIDER=manual
SUPPORT_INQUIRY_NUMBER=0700000000
